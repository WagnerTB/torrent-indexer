# Domínio base no Cloudflare (sem "www", sem barra)
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# IP público do VPS (endpoint do WireGuard e, no modo public, registro A)
# 203.0.113.10 é apenas placeholder (TEST-NET-3). Troque pelo IP real.
VPS_PUBLIC_IP=203.0.113.10

# WireGuard
VPS_WG_IP=10.8.0.1
PI_WG_IP=10.8.0.2
WG_PORT=51820

# Cloudflare Tunnel (modo tunnel)
# Zero Trust -> Networks -> Tunnels -> seu tunnel -> Configure -> token
TUNNEL_TOKEN=
