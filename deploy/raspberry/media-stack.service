[Unit]
Description=Media stack (Docker Compose) - subida escalonada
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/PiMedia /srv/docker-data

[Service]
Type=oneshot
RemainAfterExit=yes
# Ajuste para o caminho do seu stack (ex.: /home/<user>/media-stack)
WorkingDirectory=/opt/media-stack
TimeoutStartSec=300
TimeoutStopSec=120
ExecStart=/usr/bin/docker compose up -d --no-build redis meilisearch solvearr
ExecStart=/usr/bin/sleep 8
ExecStart=/usr/bin/docker compose up -d --no-build torrent-indexer qbittorrent prowlarr stremio-server
ExecStart=/usr/bin/sleep 8
ExecStart=/usr/bin/docker compose up -d --no-build sonarr bazarr jellyfin
ExecStart=/usr/bin/sleep 8
ExecStart=/usr/bin/docker compose up -d --no-build radarr seerr homepage
ExecStart=/usr/bin/sleep 5
ExecStart=/usr/bin/docker compose up -d --no-build gaming-agent media-agent
ExecStop=/usr/bin/docker compose stop

[Install]
WantedBy=multi-user.target
