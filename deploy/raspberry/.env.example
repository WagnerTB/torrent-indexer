# Copie este arquivo para .env e preencha os valores.
# O .env NÃO é versionado.
#
# O mesmo MEILI_MASTER_KEY deve ser usado pelo Meilisearch e pelo indexer.
# Gere uma chave forte, por exemplo:
#   openssl rand -base64 32

TZ=America/Sao_Paulo
PUID=1000
PGID=1000
MEDIA_ROOT=<media-root>
DOWNLOAD_ROOT=<downloads-root>
CONFIG_ROOT=<config-root>
MEILI_MASTER_KEY=change-me-strong-random-key
OS_API_KEY=<opensubtitles-api-key>

# Rede (preencha com os valores da sua instalação)
LAN_IP=<lan-ip>
TAILSCALE_IP=<tailscale-ip>
ALLOWED_NETWORKS=<lan-subnet>,<tailscale-range>,127.0.0.0/8,fd7a:115c:a1e0::/48

# Opcionais (gaming-agent / WOL)
PC_IP=<pc-tailscale-ip>,<pc-lan-ip>
PC_MAC=<pc-mac>
LAN_BROADCAST=<lan-broadcast>
GAMING_PASSWORD=change-me-strong-random-password

# Admin agent (LAN-only). A senha NÃO fica no .env: use um arquivo 600.
ADMIN_LAN_SUBNET=<lan-subnet>
ADMIN_PASSWORD_PATH=<path-to-admin-password>

# VPS Controller (Oracle) — só o BFF usa. Nunca expor ao app/logs/Git.
# GET /status usa READ_TOKEN; POST /wake usa WAKE_TOKEN (separados).
VPS_CONTROLLER_URL=https://controle.wtbsrv.com.br
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
VPS_CONTROLLER_READ_TOKEN=
VPS_CONTROLLER_WAKE_TOKEN=
